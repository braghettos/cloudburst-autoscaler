kind: Cluster
apiVersion: kind.x-k8s.io/v1alpha4
name: ${KIND_CLUSTER_NAME}
networking:
  apiServerAddress: "0.0.0.0"
  apiServerPort: 6443
  podSubnet: "10.244.0.0/16"
  serviceSubnet: "10.96.0.0/16"
# Pin node image to match worker kubelet version (NodeClass kubernetesVersion). Avoids version skew
# where a newer control plane writes config (e.g. caCertificateValidityPeriod, logging.options.text)
# that older kubelet strict-decoding rejects, causing kubelet to fail to start.
nodes:
- role: control-plane
  image: kindest/node:v1.34.3
  kubeadmConfigPatches:
  - |
    kind: InitConfiguration
    nodeRegistration:
      kubeletExtraArgs:
        node-labels: "cloudburst.io/node=control-plane"
  - |
    kind: ClusterConfiguration
    apiServer:
      certSANs:
      - "${HOST_TS_IP}"
      - "localhost"
      - "127.0.0.1"
  # Do NOT add extraPortMappings for 6443: networking.apiServerPort already exposes it.
  # Duplicate mapping caused: "failed to bind host port 6443: address already in use"
