# =============================================================================
# Cloudburst Autoscaler - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values.
# The Makefile and test scripts will automatically read from .env if it exists.
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your values
#
# To add new keys from .env.example to an existing .env without overwriting:
#   make env-align
#   Run 'make env-align' to sync new keys from this file into .env.
#
#   make deploy-all   # deployment
#   ./hack/integration-test-e2e-all-providers.sh   # E2E test (all enabled providers)
# =============================================================================

# ── GCP Configuration (Required) ────────────────────────────────────────────
# Path to GCP service account JSON key file
# This file should have permissions to create/delete compute instances
GOOGLE_APPLICATION_CREDENTIALS=/path/to/gcp-service-account.json
# GCP project and zone (used by E2E scripts and NodeClass; can be read from SA JSON)
GCP_PROJECT=your-gcp-project-id
GCP_ZONE=europe-west1-b

# ── Scaleway Configuration (Required for Scaleway provider) ─────────────────
# Project ID (used by E2E scripts and optionally by controller; also in NodeClass)
SCW_PROJECT_ID=your-scaleway-project-id
# Scaleway Secret Key (required for Scaleway API operations)
# Generate at: https://console.scaleway.com/iam/api-keys
# This is used by the controller to authenticate with Scaleway API
# Note: Store this in a Kubernetes secret referenced by NodeClass.Spec.Scaleway.APIKeySecretRef
# The secret should contain both SCW_SECRET_KEY (required) and SCW_ACCESS_KEY (recommended)
SCW_SECRET_KEY=your-scaleway-secret-key

# Scaleway Access Key (recommended)
# Scaleway API tokens consist of an access key and secret key pair.
# Both SCW_ACCESS_KEY and SCW_SECRET_KEY are typically required for authentication.
# Note: Store this in the same Kubernetes secret as SCW_SECRET_KEY
SCW_ACCESS_KEY=your-scaleway-access-key

# ── Hetzner Cloud Configuration (Required for Hetzner provider) ──────────────
# Hetzner Cloud API Token
# Generate at: https://console.hetzner.cloud/ → Project → Security → API Tokens
# Requires read/write permissions
# Note: Store this in a Kubernetes secret referenced by NodeClass.Spec.Hetzner.APITokenSecretRef
# Or set as env var for the controller
HETZNER_API_TOKEN=your-hetzner-api-token

# ── DigitalOcean Configuration (Required for DigitalOcean provider) ───────────
# DigitalOcean API Token
# Generate at: https://cloud.digitalocean.com/account/api/tokens
# Requires read/write permissions
# Note: Store this in a Kubernetes secret referenced by NodeClass.Spec.DigitalOcean.APITokenSecretRef
# Or set as env var for the controller
DIGITALOCEAN_API_TOKEN=your-digitalocean-api-token

# ── Aruba Cloud Configuration (Required for Aruba provider) ───────────────────
# Aruba API credentials (create at https://my.arubacloud.com → API Keys)
# Store in Kubernetes secrets referenced by NodeClass.Spec.Aruba.*SecretRef, or set here
ARUBA_API_KEY=your-aruba-api-key
ARUBA_API_SECRET=your-aruba-api-secret
# Aruba Cloud project ID
ARUBA_PROJECT_ID=your-aruba-project-id

# ── UpCloud Configuration (Required for UpCloud provider) ─────────────────────
# UpCloud API Token
# Generate at: https://hub.upcloud.com/account/api-tokens
# Note: Store in Kubernetes secret referenced by NodeClass.Spec.UpCloud.APITokenSecretRef
# Or set as env var for the controller
UPCLOUD_API_TOKEN=your-upcloud-api-token
# Zone for E2E (e.g. fi-hel1, de-fra1)
UPCLOUD_ZONE=fi-hel1

# ── Exoscale Configuration (Required for Exoscale provider) ───────────────────
# Exoscale API key and secret (create at https://portal.exoscale.com/iam/api-keys)
# Note: Store in Kubernetes secrets referenced by NodeClass.Spec.Exoscale.APIKeySecretRef and APISecretSecretRef
# Or set as env vars for the controller
EXOSCALE_API_KEY=your-exoscale-api-key
EXOSCALE_API_SECRET=your-exoscale-api-secret
# Zone for E2E (e.g. ch-gva-2, at-vie-1)
EXOSCALE_ZONE=ch-gva-2

# ── OVH Cloud Configuration (Required for OVH provider) ───────────────────────
# OVH API credentials (create at https://eu.api.ovh.com/createApp/)
# Store in Kubernetes secrets referenced by NodeClass.Spec.OVH.*SecretRef, or set here
OVH_APPLICATION_KEY=your-ovh-application-key
OVH_APPLICATION_SECRET=your-ovh-application-secret
OVH_CONSUMER_KEY=your-ovh-consumer-key
# OVH Cloud project ID (serviceName)
OVH_PROJECT_ID=your-ovh-project-id

# ── AWS Configuration (Required for AWS provider) ─────────────────────────────
# AWS credentials (optional if using IAM role for controller)
# Store in Kubernetes secrets referenced by NodeClass.Spec.AWS.*SecretRef, or set here
# Region comes from CloudBroker recommendation (NodeClaim.Spec.Chosen.Region).
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
# AWS region for E2E tests (e.g. eu-west-1, us-east-1)
AWS_REGION=eu-west-1
# Ubuntu 22.04 AMI ID for EC2 instances (leave empty to auto-resolve via AWS CLI)
# To find manually: aws ec2 describe-images --owners 099720109477 \
#   --filters "Name=name,Values=ubuntu/images/hvm-ssd/ubuntu-jammy-22.04-amd64-server-*" \
#   --query 'Images | sort_by(@, &CreationDate) | [-1].ImageId' --output text --region $AWS_REGION
AWS_AMI=
# Optional: Subnet ID (uses default VPC if empty)
AWS_SUBNET_ID=
# Optional: Comma-separated security group IDs
AWS_SECURITY_GROUP_IDS=

# ── Azure Configuration (Required for Azure provider) ─────────────────────────
# Service Principal credentials (optional if using Managed Identity for the controller)
# Generate at: az ad sp create-for-rbac --name cloudburst --role Contributor --scopes /subscriptions/<sub-id>
AZURE_TENANT_ID=your-azure-tenant-id
AZURE_CLIENT_ID=your-azure-client-id
AZURE_CLIENT_SECRET=your-azure-client-secret
AZURE_SUBSCRIPTION_ID=your-azure-subscription-id
# Resource group where VMs and NICs will be created (must already exist)
# Create: az group create --name cloudburst-rg --location westeurope
AZURE_RESOURCE_GROUP=cloudburst-rg
# Azure region (must match the VNet/Subnet location)
AZURE_LOCATION=westeurope
# Optional: Full ARM resource ID of the subnet for VM NICs.
# When empty, the provisioner auto-creates VNet (cloudburst-vnet) and subnet (default) in the resource group.
# To use an existing subnet, create VNet + Subnet:
#   az network vnet create --resource-group cloudburst-rg --name cloudburst-vnet \
#     --address-prefix 10.0.0.0/16 --subnet-name default --subnet-prefix 10.0.0.0/24
# Then: az network vnet subnet show --resource-group cloudburst-rg \
#   --vnet-name cloudburst-vnet --name default --query id -o tsv
AZURE_SUBNET_ID=

# ── Seeweb Configuration (Required for Seeweb provider) ──────────────────────
# API token from Seeweb control panel
SEEWEB_API_TOKEN=your-seeweb-api-token

# ── Contabo Configuration (Required for Contabo provider) ──────────────────────
# OAuth2 credentials from Contabo Customer Control Panel
CONTABO_CLIENT_ID=your-contabo-client-id
CONTABO_CLIENT_SECRET=your-contabo-client-secret
CONTABO_API_USER=your-contabo-api-user
CONTABO_API_PASSWORD=your-contabo-api-password
CONTABO_REGION=eu-de-1

# ── Gcore Configuration (Required for Gcore provider) ─────────────────────────
# API key from https://gcore.com/; Project ID from Gcore console
GCORE_API_KEY=your-gcore-api-key
GCORE_PROJECT_ID=1

# ── Cherry Servers Configuration (Required for Cherry Servers provider) ───────
# API token from https://portal.cherryservers.com/; Project ID from portal
CHERRY_SERVERS_API_TOKEN=your-cherry-servers-api-token
CHERRY_SERVERS_PROJECT_ID=your-project-id
CHERRY_SERVERS_REGION=eu-lt-1

# ── Clouding.io Configuration (Required for Clouding provider) ───────────────
# API key from https://clouding.io/
# Optional: Firewall ID (provisioner fetches first available if empty)
CLOUDING_API_KEY=your-clouding-api-key
CLOUDING_FIREWALL_ID=

# ── IBM Cloud Configuration (Required for IBM Cloud provider) ────────────────
# API key from https://cloud.ibm.com/iam/apikeys
# Resource group ID and VPC subnet ID for the region (create VPC + subnet in IBM Cloud console)
IBMCLOUD_API_KEY=your-ibm-cloud-api-key
IBMCLOUD_RESOURCE_GROUP=your-resource-group-id
IBMCLOUD_SUBNET_ID=your-subnet-id
IBMCLOUD_REGION=eu-de

# ── Tailscale Configuration (Required) ────────────────────────────────────────
# Tailscale auth key for joining nodes to your tailnet
# Generate at: https://login.tailscale.com/admin/settings/keys
# Use a reusable key with appropriate permissions
TAILSCALE_AUTHKEY=tskey-auth-xxxxxxx

# ── CloudBroker API Configuration (Optional) ────────────────────────────────
# Base URL for CloudBroker API service
# Defaults to http://<host-tailscale-ip>:8000 if not set
# CLOUDBROKER_BASEURL=http://localhost:8000
# API key for CloudBroker (required when CloudBroker has API_KEY set in production)
# CLOUDBROKER_API_KEY=your-api-key

# ── Test Configuration (Optional) ──────────────────────────────────────────
# Note: Test scripts may use GCP_PROJECT, GCP_ZONE, SCW_PROJECT_ID, etc. for
# cleanup and setup. These are only used by test scripts, not by the controller
# itself. The controller reads all provider-specific configuration from NodeClass
# resources (GCP project/zone, Scaleway project ID/zone, etc.).
#
# Kind cluster name (defaults to "cloudburst")
# KIND_CLUSTER_NAME=cloudburst

# Kubernetes namespace for test resources (defaults to "default")
# TEST_NAMESPACE=default

# ── Timeout Configuration (Optional) ───────────────────────────────────────
# Timeout in seconds for NodeClaim creation (default: 300)
# NODECLAIM_CREATE_TIMEOUT=300

# Timeout in seconds for VM provisioning (default: 600)
# PROVISIONING_TIMEOUT=600

# Timeout in seconds for node to become Ready (default: 600)
# READY_TIMEOUT=600

# Timeout in seconds for pod to be scheduled (default: 120)
# POD_SCHEDULED_TIMEOUT=120

# Timeout in seconds for node scale-down (default: 300, e2e test only)
# SCALEDOWN_TIMEOUT=300

# Timeout in seconds for VM deletion after NodeClaim removal (default: 300, e2e test only)
# VM_DELETION_TIMEOUT=300
